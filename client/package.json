{
  "name": "cyber-girlfriend-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "赛博女友前端（React 单页）：AvatarCanvas 数字人画布 / 聊天 UI / 字幕 / 波形",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:avatar": "node --experimental-strip-types src/components/avatar-canvas-test.ts",
    "test:avatar-hook": "node --experimental-strip-types src/hooks/use-avatar-test.ts",
    "test:chat": "node --experimental-strip-types src/components/chat-core-test.ts",
    "test:chat-hook": "node --experimental-strip-types src/hooks/use-chat-test.ts",
    "test:caption": "node --experimental-strip-types src/components/caption-core-test.ts",
    "test:waveform": "node --experimental-strip-types src/components/waveform-core-test.ts",
    "test:voice": "esbuild src/voice/voice-test.ts --bundle --format=esm --outfile=.tmp/voice-test.mjs && node .tmp/voice-test.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
