# 项目级 npm/pnpm 配置（国内源策略，见 DESIGN.md §16 / DEPENDENCIES.md）
# 说明：本机 npm 在 Node 22 编译缓存（v8 compile cache）下会挂起，
#       安装命令统一加 NODE_DISABLE_COMPILE_CACHE=1（见 package.json 脚本或 DEPENDENCIES.md）

# 国内镜像源（npmmirror，阿里云系，与 npmjs 同步）
registry=https://registry.npmmirror.com

# better-sqlite3 预编译二进制走国内镜像（避免 GitHub 下载慢/失败）
better_sqlite3_binary_host=https://npmmirror.com/mirrors/better-sqlite3/

# pnpm 使用兼容 npm 的 node_modules 结构（对 tsx/vite/tailwind 等工具最友好）
shamefully-hoist=true
