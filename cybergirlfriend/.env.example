# 环境变量配置（复制为 .env 后填写）
# 说明见 DESIGN.md §10；密钥绝不可提交到 Git（已在 .gitignore 忽略）

# ── CodeBuddy Agent SDK（必填，聊天功能）────────────────────────────
CODEBUDDY_API_KEY=

# ── S2S 语音（v0.1 默认 Qwen 端到端，阿里云 DashScope）───────────────
VOICE_PROVIDER=qwen_omni
DASHSCOPE_API_KEY=
# GLM_API_KEY=                    # GLM-Realtime 备选（预留，按需再加）

# ── 数字人素材库（v0.1）─────────────────────────────────────────────
AVATAR_ENGINE=clip_library

# ── MCP 服务器（v0.1 启用两个）───────────────────────────────────────
WORKBUDDY_MCP_URL=              # Work Buddy 网关地址（按平台提供）
WORKBUDDY_MCP_TOKEN=
HERMES_BIN=hermes               # Hermes agent 可执行文件路径

# ── 测试（可选覆盖）─────────────────────────────────────────────────
# CI=true                        # CI 模式下 Playwright 会安装浏览器依赖
