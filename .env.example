# ===== 赛博女友 · 环境变量模板（AP-06 + M5-05 完善） =====
# 用法：复制本文件为项目根目录 .env（已 gitignore），按需填写。
# 优先级：config/apikeys.json > 系统环境变量 > .env.local > .env > 默认值
#   - .env.local 用于本地覆盖（同样不进 git），会覆盖 .env 的同名键
#   - 系统环境变量始终优先，.env 不会覆盖已存在的键
# 密钥统一走 config/loader.ts 加载（红线 3），源码中不硬编码。
# 完整变量清单见 config/loader.ts 的 AppConfig 与 mergeWithEnv()。

# --- DashScope（语音壳 Qwen-Audio Realtime） ---
# 必填：语音问答核心密钥（dashscope.aliyuncs.com），无值则语音壳无法连接
DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=            # 阿里云百炼工作空间 ID（可选）
# DASHSCOPE_REGION=cn-beijing        # 服务区域，默认 cn-beijing
# DASHSCOPE_MODEL=qwen-audio-3.0-realtime-flash  # Realtime 语音模型，默认如上

# --- Hermes（本机大脑） ---
# HERMES_BIN=hermes                  # hermes 可执行文件路径，默认取 PATH 中的 hermes
#                                    #   （本机实测路径：C:/Users/chipsine/AppData/Local/hermes/hermes-agent/.venv/Scripts/hermes）
# HERMES_MODEL_PROVIDER=deepseek     # Hermes 底层模型提供商，默认 deepseek
# HERMES_API_KEY=                    # Hermes 模型 API Key（有则优先于 Hermes 自带配置）
# HERMES_BASE_URL=                   # Hermes 模型 API Base URL（可选，走官方默认）
# HERMES_PROFILE=cyber-girlfriend    # 专用 profile（记忆隔离红线：与主 profile 互不污染），默认 cyber-girlfriend
# HERMES_PERSONAS_DIR=C:/Users/chipsine/AppData/Local/hermes/profiles/cyber-girlfriend/personas
#                                    # 人设数据权威源目录（personas.json/active.txt/card.md/memory.md）
# HERMES_TOOLSETS=terminal,file,web  # Hermes 工具白名单（不含 memory，写隔离硬约束），默认如上

# --- 服务 ---
# PORT=3000                          # 后端 HTTP/WS 端口，默认 3000
# HOST=localhost                     # 监听地址，默认 localhost（局域网访问改 0.0.0.0）

# --- 预留（voice-shell 模块 VS-01 待用，loader 已透传任意键） ---
# VOICE_PROVIDER=qwen_audio          # 语音提供商开关（qwen_audio / qwen_omni，预留）
